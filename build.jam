# secure: the side-channel and secret-in-memory primitives webcpp's libraries
# share; a program names /webcpp/secure//secure:
#
#     exe app : app.cpp /webcpp/secure//secure ;

import webcpp-target ;

project /webcpp/secure ;

# tag::secure[]
alias secure : : : : <include>include <library>/boost//headers <library>/webcpp/config//config ;
# end::secure[]
